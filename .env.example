# ========== REQUIRED ==========

# Site URL (used for metadata canonical URLs and Open Graph)
NEXT_PUBLIC_SITE_URL=https://axiom-canine.netlify.app

# Disable Next.js telemetry during builds
NEXT_TELEMETRY_DISABLED=1

# ========== OPTIONAL ==========

# Google Ads conversion tag (enabled in netlify.toml for production)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18020403242

# Google Analytics (optional - uncomment to enable)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Google Ads conversion labels (set in Google Ads, then paste the label only — not the full AW-ID/label)
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=

# Email notifications (if using custom email service)
# SENDGRID_API_KEY=your_sendgrid_key_here

# ========== NETLIFY FORMS ==========
# Netlify Forms are automatically handled - no config needed
# Forms are submitted to: https://axiom-canine.netlify.app/
# View submissions in Netlify Dashboard → Forms
